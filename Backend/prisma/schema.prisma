// Splitzy — Prisma schema (Task 2: PostgreSQL database schema)
//
// Conventions
// -----------
// Money: NEVER floating point. Every monetary value is stored as an integer
//        number of minor units (paise for INR, cents for USD/EUR/GBP/AUD;
//        JPY is zero-decimal so minor units == yen). Column names use the
//        `*Minor` suffix (amountMinor, shareMinor). Currency is always stored
//        alongside the amount as a 3-letter ISO 4217 code. Conversion between
//        currencies is NOT performed at the database layer.
// IDs:   UUIDs generated by PostgreSQL (gen_random_uuid(), built into
//        PostgreSQL 13+; on older versions the pgcrypto extension provides
//        it — see the note in the initial migration).
// Time:  createdAt defaults to now(); updatedAt is maintained by Prisma.
//
// Category note: expense categories (Food, Travel, Rent, Utilities, Shopping,
// Entertainment, Other — mirroring the frontend's CATEGORIES in
// AddExpenseModal.jsx) are stored as plain text rather than a database enum.
// This keeps category extensibility cheap (adding a category must not require
// a destructive enum migration). The allowed set is enforced by application
// services, typed as a union in src/types/.
//
// Authentication note: Splitzy has no password/credential columns. Firebase
// Authentication is the identity provider (Task 4): the User model carries a
// unique `firebaseUid` as the stable external identity key, while `id` remains
// the internal PostgreSQL identity that all application data references.
// Email stays a data-integrity unique but is NOT the identity key — emails can
// change and additional providers may exist later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Role of a user within a group.
enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

/// How an expense (or recurring expense) is divided among participants.
enum SplitType {
  EQUAL
  PERCENTAGE
  ITEMIZED
}

/// Lifecycle of a settlement between two members.
enum SettlementStatus {
  PENDING
  COMPLETED
  CANCELLED
}

/// How a settlement was (or will be) paid. UPI integration itself is a later
/// task — this only records the method on the data model.
enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  OTHER
}

/// How often a recurring expense materializes.
enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

// ---------------------------------------------------------------------------
// Users & groups
// ---------------------------------------------------------------------------

/// A Splitzy account.
///
/// Identity model (Task 4):
///   id          — internal Splitzy identity; all relations point here.
///   firebaseUid — external Firebase identity, unique, stable. Every Splitzy
///                 user is provisioned from a verified Firebase ID token on
///                 first login (find-or-create keyed on firebaseUid).
///   email       — unique for data integrity, but NOT the identity key.
/// No password/credential columns exist or are needed.
model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Firebase Authentication UID of this account (unique identity key).
  firebaseUid  String    @unique
  email        String    @unique
  name         String
  /// Human-friendly discovery identifier. Nullable only for legacy users until
  /// they complete the updated profile setup flow.
  username     String?   @unique
  birthdate    DateTime?
  /// Profile photo URL from the verified identity provider (Google).
  photoUrl     String?
  /// Frontend avatar token (e.g. "avatar_cool"). Nullable until onboarding.
  avatarId     String?
  /// Preferred display currency (ISO 4217, e.g. INR).
  currencyCode String    @default("INR") @db.Char(3)
  /// IANA timezone for date grouping (calendar, monthly insights).
  timezone     String    @default("UTC")
  /// Saved UPI ID for settlement payments.
  upiId        String?
  /// Optional saved QR reference; do not store unnecessary raw sensitive data.
  upiQrDataUrl String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ownedGroups              Group[]                       @relation("GroupCreatedBy")
  memberships              GroupMember[]
  expensesPaid             Expense[]                     @relation("ExpensePaidBy")
  expensesCreated          Expense[]                     @relation("ExpenseCreatedBy")
  expenseParticipations    ExpenseParticipant[]
  itemParticipations       ExpenseItemParticipant[]
  settlementsSent          Settlement[]                  @relation("SettlementFromUser")
  settlementsReceived      Settlement[]                  @relation("SettlementToUser")
  recurringExpensesPaid    RecurringExpense[]            @relation("RecurringExpensePaidBy")
  recurringExpensesCreated RecurringExpense[]            @relation("RecurringExpenseCreatedBy")
  recurringParticipations  RecurringExpenseParticipant[]

  @@index([email])
}

/// A bill-splitting group (trip, flat, friends...).
model Group {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  description     String?
  /// Group currency — all expenses and settlements of the group use it.
  currencyCode    String   @default("INR") @db.Char(3)
  /// Frontend concept: roommate-style household group (RoommateMode).
  isRoommateGroup Boolean  @default(false)
  createdById     String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy         User               @relation("GroupCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  members           GroupMember[]
  expenses          Expense[]
  settlements       Settlement[]
  recurringExpenses RecurringExpense[]

  @@index([createdById])
}

/// Join table: many users belong to many groups. One membership row per
/// (group, user) pair, enforced by a unique constraint.
model GroupMember {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId  String    @db.Uuid
  userId   String    @db.Uuid
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Expenses
// ---------------------------------------------------------------------------

/// A shared expense within a group. Money is stored in integer minor units —
/// never floating point.
model Expense {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId      String    @db.Uuid
  description  String
  /// One of the frontend categories (Food, Travel, Rent, Utilities, Shopping,
  /// Entertainment, Other). Plain text on purpose — see header note.
  category     String
  /// Amount in minor units (e.g. ₹100.50 -> 10050). Must be >= 0.
  amountMinor  BigInt
  currencyCode String    @db.Char(3)
  paidById     String?   @db.Uuid
  splitType    SplitType @default(EQUAL)
  /// When the expense occurred (frontend sets explicit dates).
  expenseDate  DateTime  @default(now())
  createdById  String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  group        Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Payer attribution. Nullable + SetNull so deleting a user never destroys
  /// historical financial records.
  paidBy       User?                @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  /// Creator attribution — same preservation rule as paidBy.
  createdBy    User?                @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  participants ExpenseParticipant[]
  items        ExpenseItem[]

  @@index([groupId])
  @@index([paidById])
  @@index([createdById])
  @@index([expenseDate])
  @@index([groupId, expenseDate])
}

/// Who participates in an expense and how much they owe.
///
/// - EQUAL:      one row per participant; shareMinor = amountMinor / count
///               (remainder resolved by the split service).
/// - PERCENTAGE: percentage is stored to reproduce the split.
/// - ITEMIZED:   owed amounts derive from ExpenseItemParticipant rows; the
///               ExpenseParticipant row stores the computed total share.
model ExpenseParticipant {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expenseId  String   @db.Uuid
  userId     String?  @db.Uuid
  /// Participant's owed share in minor units. Must be >= 0.
  shareMinor BigInt
  /// Only meaningful for PERCENTAGE splits (0..100).
  percentage Decimal? @db.Decimal(5, 2)
  createdAt  DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  /// Nullable + SetNull: participation history survives user deletion.
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([expenseId, userId])
  @@index([expenseId])
  @@index([userId])
}

/// One itemized line of an ITEMIZED expense (e.g. "Pizza ₹600").
model ExpenseItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expenseId   String   @db.Uuid
  description String
  /// Item price in minor units. Must be >= 0.
  amountMinor BigInt
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expense      Expense                  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  participants ExpenseItemParticipant[]

  @@index([expenseId])
}

/// Assigns a portion of a single item to a user (e.g. Pizza shared by A and B).
model ExpenseItemParticipant {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId     String   @db.Uuid
  userId     String?  @db.Uuid
  /// This user's portion of the item in minor units. Must be >= 0.
  shareMinor BigInt
  createdAt  DateTime @default(now())

  item ExpenseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Settlements
// ---------------------------------------------------------------------------

/// Money one member pays another to reduce an outstanding balance.
///
/// Deliberately a first-class entity — NEVER modeled as a fake expense.
/// Financial history: deleting a user nullifies from/to attribution but keeps
/// the settlement row; deleting a group removes its settlements together with
/// the group's expenses.
model Settlement {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId      String           @db.Uuid
  fromUserId   String?          @db.Uuid
  toUserId     String?          @db.Uuid
  /// Amount in minor units. Must be >= 0.
  amountMinor  BigInt
  currencyCode String           @db.Char(3)
  status       SettlementStatus @default(PENDING)
  method       PaymentMethod    @default(CASH)
  note         String?
  /// When the settlement was marked COMPLETED (null until then).
  settledAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUser User? @relation("SettlementFromUser", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser   User? @relation("SettlementToUser", fields: [toUserId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@index([fromUserId])
  @@index([toUserId])
}

// ---------------------------------------------------------------------------
// Recurring expenses
// ---------------------------------------------------------------------------

/// A repeating expense template (e.g. monthly flat rent). A scheduler that
/// materializes these into Expense rows is a future task — this is only the
/// data model.
model RecurringExpense {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId      String             @db.Uuid
  description  String
  category     String
  /// Amount per occurrence, in minor units. Must be >= 0.
  amountMinor  BigInt
  currencyCode String             @db.Char(3)
  paidById     String?            @db.Uuid
  splitType    SplitType          @default(EQUAL)
  frequency    RecurringFrequency @default(MONTHLY)
  /// Next scheduled materialization — consumed by the future scheduler.
  nextRunAt    DateTime
  isActive     Boolean            @default(true)
  createdById  String?            @db.Uuid
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  group        Group                         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy       User?                         @relation("RecurringExpensePaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  createdBy    User?                         @relation("RecurringExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  participants RecurringExpenseParticipant[]

  @@index([groupId])
  @@index([paidById])
  @@index([createdById])
  @@index([nextRunAt])
}

/// Participant configuration for a recurring expense. Defined independently
/// from ExpenseParticipant — participants of a template are NOT copied from
/// any materialized expense.
///
/// shareMinor is nullable on purpose: for EQUAL splits the share is derived at
/// materialization time (null here); PERCENTAGE splits store `percentage`;
/// a materialization service may also precompute and store shareMinor.
model RecurringExpenseParticipant {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recurringExpenseId String   @db.Uuid
  userId             String?  @db.Uuid
  /// Precomputed share in minor units, if known ahead of materialization.
  /// Null for equal splits derived at materialization time. Must be >= 0.
  shareMinor         BigInt?
  /// Only meaningful for PERCENTAGE splits (0..100).
  percentage         Decimal? @db.Decimal(5, 2)
  createdAt          DateTime @default(now())

  recurringExpense RecurringExpense @relation(fields: [recurringExpenseId], references: [id], onDelete: Cascade)
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([recurringExpenseId, userId])
  @@index([recurringExpenseId])
  @@index([userId])
}
