[TEMPLATE]
# Splitzy API — environment configuration template
# Copy this file to `.env` and adjust values. NEVER commit a real `.env`.

# ---------------------------------------------------------------------
# Common (development + production)
# ---------------------------------------------------------------------

# HTTP port the API listens on
PORT=5000

# development | production | test
NODE_ENV=development

# PostgreSQL connection string (consumed via Prisma)
DATABASE_URL=postgresql://postgres:password@localhost:5432/splitzy

# Comma-separated list of allowed browser origins (no trailing slashes)
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------
# Authentication — DEVELOPMENT (ignored when NODE_ENV=production)
# ---------------------------------------------------------------------
#
# No configuration is needed for local development. When NODE_ENV is not
# "production", requests may authenticate by sending an explicit,
# clearly-named header that asserts a Firebase UID WITHOUT verification:
#
#     x-dev-user-id: <any-firebase-uid-shaped-string>
#
# e.g.  curl -H "x-dev-user-id: dev-user-1" http://localhost:5000/api/v1/auth/me
#
# This path exists only so the API can be exercised before Firebase is
# configured (and by automated tests). It is structurally unreachable in
# production: production requests MUST present a real Firebase ID token.

# ---------------------------------------------------------------------
# Authentication — PRODUCTION (Firebase Admin)
# ---------------------------------------------------------------------
#
# In production every request must carry `Authorization: Bearer <Firebase ID
# token>`, verified with the Firebase Admin SDK. Configure at deploy time:
#
# FIREBASE_PROJECT_ID=your-firebase-project-id
#
# Credentials (choose ONE — never commit either):
#   1. GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/splitzy-firebase-sa.json
#      (path to a service-account JSON mounted by your deployment system), or
#   2. nothing — rely on Application Default Credentials (Cloud Run, GCE, etc.)
#
# Both values are read by src/services/authService.ts. No service-account
# JSON, private key, or client secret ever belongs in this repository.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
