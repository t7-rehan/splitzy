{
  "name": "splitzy-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Splitzy API server — Node.js + TypeScript + Express + Prisma (Task 1: backend foundation)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --import tsx tests/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "db:start": ".postgres-local\\bin\\pg_ctl.exe -D .postgres-local/data -o \"-p 54329\" -l .postgres-local/pg.log start",
    "db:stop": ".postgres-local\\bin\\pg_ctl.exe -D .postgres-local/data stop",
    "db:status": ".postgres-local\\bin\\pg_ctl.exe -D .postgres-local/data status",
    "db:migrate": "prisma migrate deploy",
    "db:verify": "tsx scripts/verify-schema.ts",
    "db:smoke": "tsx scripts/smoke-postgres.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "firebase-admin": "^14.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.9.1",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
