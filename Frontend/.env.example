# Splitzy frontend — environment template.
# Copy to `.env.local` (git-ignored) and fill in. NEVER commit real values.
#
# Note: VITE_* variables are build-time PUBLIC — they ship inside the JS
# bundle. Only public-by-design values belong here (the Firebase Web App
# config is public client configuration; the backend URL is not a secret).
# Real secrets (service accounts, Admin SDK keys, DB passwords) never belong
# in the frontend — they live only on the backend/deployment side.

# ---------------------------------------------------------------------
# Backend API (Task 8)
# ---------------------------------------------------------------------
# Base URL of the Splitzy Express backend (no trailing slash).
# Local default matches the backend's configured PORT.
VITE_API_BASE_URL=http://localhost:5000

# ---------------------------------------------------------------------
# Firebase Web App configuration (public client config — NOT secrets)
# ---------------------------------------------------------------------
# Firebase console → Project settings → General → Your apps → Web app.
# Authentication only works with a real project's values; sign-in shows a
# friendly "not configured" message when these are empty.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
